# Application
NODE_ENV=production
PORT=3000
APP_URL=https://blackbird.example.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blackbird_prod
DB_USER=blackbird_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Security
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=https://blackbird.example.com

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=
